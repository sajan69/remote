{
  "name": "gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:ws --external:bufferutil --external:utf-8-validate",
    "start": "node dist/server.js",
