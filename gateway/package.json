  },
  "dependencies": {
    "@remote/protocol": "*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
