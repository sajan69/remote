{
  "name": "gateway",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:ws --external:bufferutil --external:utf-8-validate",
    "start": "node dist/server.js",
    "test": "tsx --test test/protocol.test.ts test/ha-map.test.ts test/commands.test.ts test/http.test.ts"
  },
  "dependencies": {
    "@remote/protocol": "*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6"
  }
}
